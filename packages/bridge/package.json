{
  "name": "pi-browser-bridge",
  "version": "0.1.0",
  "description": "pi extension: HTTP/SSE bridge between the pi agent and the Browser Agent Chrome extension",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
