{
  "name": "pi-browser-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/bridge",
    "packages/host",
    "extension"
  ],
  "scripts": {
    "build": "npm run build -w extension",
    "typecheck": "tsc -p packages/shared && tsc -p packages/bridge && tsc -p packages/host && tsc -p extension",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bundle:bridge": "node scripts/bundle-bridge.mjs",
    "test:all": "npm run typecheck && npm run build && vitest run && playwright test",
    "notices": "node scripts/third-party.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:acceptance": "PI_ACCEPTANCE=1 playwright test acceptance.real",
    "build:npm": "node scripts/build-npm-packages.mjs",
    "pack:extension": "node scripts/pack-extension.mjs",
    "release:check": "node scripts/release-check.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/jsdom": "^30.0.0",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.21.5",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
